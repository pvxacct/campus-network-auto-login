<Window x:Class="CampusNet.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级设置" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Style="{StaticResource Card}" Margin="16,14,16,14">
        <StackPanel>
            <TextBlock Text="高级设置" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="输入框改完（点开别处或按回车）即自动保存并立即生效；超出范围的整数会被钳制到边界。本版已删除「最小间隔 / 每小时上限」两项限速，登录频率只剩「登录前 1 秒二次确认」和 Portal 自己返回的限流提示。" />

            <!-- 两列 × 4 行（8 项）：整窗内容固定，不需要滚动条。行/列数必须不小于用到的最大索引，
                 WPF 对越界行号不报错而是塞进最后一行，两个控件就会叠印（pre.7 的界面回归）。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" MinWidth="80" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" MinWidth="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="正常时探测间隔（秒）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="OnlineProbeBox" Grid.Row="0" Grid.Column="1" Tag="OnlineProbeSeconds" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" Margin="0,0,0,8" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="兜底巡检间隔（秒）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="UpstreamProbeBox" Grid.Row="0" Grid.Column="4" Tag="UpstreamProbeSeconds" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="异常时探测间隔（秒）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="OfflineProbeBox" Grid.Row="1" Grid.Column="1" Tag="OfflineProbeSeconds" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="探测超时（毫秒）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="ProbeTimeoutBox" Grid.Row="1" Grid.Column="4" Tag="ProbeTimeoutMs" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Portal 地址" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="PortalHostBox" Grid.Row="2" Grid.Column="1" LostFocus="PortalHost_LostFocus" KeyDown="PortalHost_KeyDown" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="HTTP 探测超时（毫秒）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="HttpProbeTimeoutBox" Grid.Row="2" Grid.Column="4" Tag="HttpProbeTimeoutMs" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="会话核对间隔（秒，0=关闭）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="SessionCheckBox" Grid.Row="3" Grid.Column="1" Tag="SessionCheckSeconds" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" />
                <TextBlock Grid.Row="3" Grid.Column="3" Text="残留会话自动重登（秒，0=关闭）" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="StuckReloginBox" Grid.Row="3" Grid.Column="4" Tag="StuckReloginSeconds" LostFocus="AdvancedBox_LostFocus" KeyDown="AdvancedBox_KeyDown" />
            </Grid>

            <TextBlock x:Name="AdvancedHint" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="每项都标了允许范围；改完立刻写盘并重载，不需要「保存」按钮。" />
            <Button Content="关闭" Click="Close_Click" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,3,16,3" />
        </StackPanel>
    </Border>
</Window>
