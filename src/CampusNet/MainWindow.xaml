<Window x:Class="CampusNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校园网自动登录" Height="840" Width="1060" MinHeight="820" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="校园网自动登录" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="10,4,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="InstallStateText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 状态横幅 -->
        <Border x:Name="StatusBanner" Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12,16,12" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="StatusDot" Width="14" Height="14" CornerRadius="7" Background="{StaticResource GrayBrush}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="正在启动…" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="0,3,0,0" Text="读取配置中" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体：整体高度固定（全 Auto），窗口缩到 MinHeight 也不会裁切、不需要滚动条。
             「高级设置」已经搬到独立窗口，所以这里不再需要 ScrollViewer。 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 左：网络 -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="网络状态" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="本机 IP" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="IpText" Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="网关" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="GatewayText" Grid.Row="0" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="网卡" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="AdapterText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="DNS" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="DnsText" Grid.Row="1" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="延迟" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <TextBlock x:Name="LatencyText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="丢包" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <TextBlock x:Name="LossText" Grid.Row="2" Grid.Column="3" Style="{StaticResource Value}" />
                    </Grid>

                    <Border Background="#FBFCFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Height="64" Margin="0,10,0,0" SnapsToDevicePixels="True">
                        <Canvas x:Name="LatencyCanvas" ClipToBounds="True" />
                    </Border>
                    <!-- 探测明细可能很长（4 条目标的逐项结果）。这里必须允许换行，
                         否则 TextBlock 会按"不换行的理想宽度"排版（实测 758px），
                         直接把文字画到卡片外面并被硬截断。 -->
                    <TextBlock x:Name="ProbeText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16"
                               MaxHeight="32" Text="等待首次探测…" />
                </StackPanel>
            </Border>

            <!-- 左：运行统计。只留「会变、看得懂」的项：2.1.1 删掉 4 行无效栏目——
                 「连续失败」在完全忽略 Portal 提示之后长期是 0；「探测方式」跟配置绑定、开通后永不变化；
                 「已忽略提示」与「最近结果 = 已忽略 Portal 提示」重复；「强制重登」几乎一直是「尚未发生」。
                 这几项在命令行的 status / diagnose 输出里仍然能看到全文。 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="运行统计" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最近探测" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatProbe" Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="最近登录" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatLogin" Grid.Row="0" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最近结果" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatResult" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="本小时登录" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatCount" Grid.Row="1" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="下次探测" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatNextProbe" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="会话校验" Style="{StaticResource Caption}" Margin="0,0,10,6" />
                        <TextBlock x:Name="StatSession" Grid.Row="2" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="今日登录" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <!-- 2.1.2 把核心逻辑回滚到 2.0.0 后，「今日登录」「恢复耗时」不再有数据源；
                             保留原位置与网格行（不动卡片高度），只显示占位横线。 -->
                        <TextBlock x:Name="StatDay" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,16,0"
                                   Text="—" ToolTip="2.1.2 起不再统计（核心逻辑已回滚到 2.0.0）" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="恢复耗时" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                        <TextBlock x:Name="StatRecovery" Grid.Row="3" Grid.Column="3" Style="{StaticResource Value}" Margin="0,0,0,0"
                                   Text="—" ToolTip="2.1.2 起不再统计（核心逻辑已回滚到 2.0.0）" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="最近错误" Style="{StaticResource Caption}" Margin="0,6,10,0" />
                        <TextBlock x:Name="StatError" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Value}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16" MaxHeight="32" Margin="0,6,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 右：账号 -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="账号" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="账号" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                            <TextBox x:Name="UserNameBox" />
                            <TextBlock x:Name="UserNamePlaceholder" Style="{StaticResource Placeholder}" Text="填学号 / 账号，例如 251731646" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Grid Grid.Row="1" Grid.Column="1">
                            <PasswordBox x:Name="PasswordInput" Padding="7,5,7,5" FontSize="12.5" BorderBrush="#D3D9E0"
                                         PasswordChanged="PasswordInput_PasswordChanged" GotKeyboardFocus="PasswordInput_FocusChanged"
                                         LostKeyboardFocus="PasswordInput_FocusChanged" />
                            <TextBlock x:Name="PasswordPlaceholder" Style="{StaticResource Placeholder}" Text="填 Portal 密码" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="CredentialHint" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="SaveCredentialButton" Content="保存账号密码" Click="SaveCredential_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                                   Text="密码用 Windows DPAPI 加密保存在本机，只有当前 Windows 用户能解密；已保存后可以只改账号、密码留空表示不改。" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 右：功能 -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="程序" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoStartCheck" Content="开机自动运行（登录后自动在托盘启动）" Click="AutoStart_Click" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button x:Name="InstallButton" Content="安装" Click="Install_Click" />
                        <Button Content="打开数据目录" Click="OpenData_Click" />
                        <Button x:Name="CleanupButton" Content="清理旧版残留" Click="Cleanup_Click" />
                        <Button x:Name="AdvancedButton" Content="高级设置" Click="Advanced_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LegacyHint" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="正在检查旧版残留…" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="「高级设置」会另开一个窗口：探测节奏、风控上限、Portal 地址都在那里改，点开别处或按回车即自动保存并立即生效。" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <!-- 右侧三个控件整体右对齐；窗口变窄时靠 WrapPanel 换行，不会互相叠印。 -->
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="FollowTailCheck" Content="跟随最新" IsChecked="True" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Click="FollowTail_Click" />
                        <CheckBox x:Name="WarningOnlyCheck" Content="只看警告和错误" Margin="0,0,12,0"
                                  VerticalAlignment="Center" Click="WarningOnly_Click" />
                        <Button Content="清除显示" Click="ClearLog_Click" Padding="10,3,10,3" VerticalAlignment="Center"
                                ToolTip="只清空这个窗口里的日志显示，不会删除本机的 login.log" />
                    </WrapPanel>
                </DockPanel>
                <!-- 高度由窗口伸缩：MinHeight=160 保证窗口缩到最小时也有 8 行左右可读；
                     只有日志区允许出现滚动条（主体内容一律不滚动，靠窗口 MinHeight 兜住）。 -->
                <RichTextBox x:Name="LogView" IsReadOnly="True" BorderThickness="0" Background="#FBFCFD" MinHeight="160"
                             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <!-- 底部按钮 -->
        <DockPanel Grid.Row="4" Margin="2,12,2,0" LastChildFill="False">
            <Button x:Name="ReloginButton" Content="立即重连" Click="Relogin_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" />
            <Button x:Name="PauseButton" Content="暂停 30 分钟" Click="Pause_Click" />
            <Button x:Name="ResumeButton" Content="恢复自动登录" Click="Resume_Click" />
            <Button Content="刷新" Click="Refresh_Click" />
            <Button Content="复制诊断信息" Click="CopyDiagnose_Click" />
                    <Button x:Name="CloseButton" Content="关闭窗口（后台继续运行）" Click="Close_Click" DockPanel.Dock="Right" Margin="8,0,0,6" />
        </DockPanel>
    </Grid>
</Window>
