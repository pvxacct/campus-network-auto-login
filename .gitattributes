# 统一换行符策略：
#   - 仓库内按 LF 存储（text=auto 自动归一化）；
#   - 检出 / 导出（含 git archive 打包）时强制 CRLF，
#     避免 Windows 下脚本与配置文件因换行符出现差异。
* text=auto
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.md   text eol=crlf
*.json text eol=crlf
*.yml  text eol=crlf
*.cs   text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln  text eol=crlf

# 编译产物必须是二进制原样存取，不能做换行符转换
*.exe  binary
*.ico  binary
*.png  binary
